HOST=0.0.0.0
PORT=8000
DEBUG=true
DATABASE_PATH=./data/agrisutra.db
CATALOGUE_PATH=./data/catalogue/sgb_catalogue.json
PRICE_POLICY_PATH=./data/policy/price_policy.json

# ── WhatsApp Business Platform (Cloud API) ──────────────────────────
# dry_run records every outbound message in the cockpit and never sends; live calls the Graph API.
WHATSAPP_SEND_MODE=dry_run
WHATSAPP_API_VERSION=v25.0
# Your own random string; enter the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard → App settings → Basic → App secret (used to verify X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# Needed only for live mode: a system-user access token and the business phone number ID.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Public HTTPS address of this server (e.g. your tunnel URL), used to link product photos.
# Leave empty to upload photos to Meta instead.
PUBLIC_BASE_URL=
# Local testing only: accept unsigned webhooks. Never enable in production.
WHATSAPP_ALLOW_UNSIGNED=false
